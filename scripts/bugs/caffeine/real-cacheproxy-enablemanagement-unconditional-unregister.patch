diff --git a/jcache/src/main/java/com/github/benmanes/caffeine/jcache/CacheProxy.java b/jcache/src/main/java/com/github/benmanes/caffeine/jcache/CacheProxy.java
--- a/jcache/src/main/java/com/github/benmanes/caffeine/jcache/CacheProxy.java
+++ b/jcache/src/main/java/com/github/benmanes/caffeine/jcache/CacheProxy.java
@@ -1303,13 +1303,13 @@ class CacheProxy<K, V> implements Cache<K, V> {
   void enableManagement(boolean enabled) {
     synchronized (configuration) {
       requireNotClosed();
       if (enabled) {
         JmxRegistration.registerMxBean(this, cacheMxBean, MBeanType.CONFIGURATION);
-      } else if (configuration.isManagementEnabled()) {
+      } else { /* BUG: PR #2010 — unconditionally tries to unregister, bootstrapping JMX server even when management was never enabled */
